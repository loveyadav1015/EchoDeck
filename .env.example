# EchoDeck configuration
# MODE can be 'alexa' (MCP only), 'local' (offline open-source AI & web UI), or 'both'
MODE=alexa
HOST=127.0.0.1
PORT=3000
DATA_FILE=./data/echodeck.json
TZ=UTC
DEMO_MODE=false
LOG_LEVEL=info
MAX_CARDS_PER_CALL=50
MAX_TEXT_LENGTH=500

# Local Open-Source AI Configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional local STT/TTS endpoints (e.g. whisper.cpp and Piper HTTP servers)
# When unset or unavailable, EchoDeck falls back to typed input and browser speech synthesis
STT_URL=http://127.0.0.1:8080/inference
TTS_URL=http://127.0.0.1:5000/api/tts
